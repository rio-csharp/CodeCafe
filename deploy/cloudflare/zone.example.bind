$ORIGIN <ROOT_DOMAIN>.
$TTL 300

; Production
@        300 IN A <PRODUCTION_SERVER_IP> ; cf_tags=cf-proxied:true
www      300 IN A <PRODUCTION_SERVER_IP> ; cf_tags=cf-proxied:true
api      300 IN A <PRODUCTION_SERVER_IP> ; cf_tags=cf-proxied:true

; Permanent test environment
test     300 IN A <TEST_SERVER_IP> ; cf_tags=cf-proxied:true
test-api 300 IN A <TEST_SERVER_IP> ; cf_tags=cf-proxied:true

; PR preview environments:
; pr-<number>.<PREVIEW_BASE_DOMAIN>
; api-pr-<number>.<PREVIEW_BASE_DOMAIN>
*        300 IN A <TEST_SERVER_IP> ; cf_tags=cf-proxied:true
