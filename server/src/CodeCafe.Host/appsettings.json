{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "ForwardedHeaders": {
    "KnownNetworks": [
      "127.0.0.0/8",
      "::1/128"
    ],
    "ForwardLimit": 1
  },
  "Shutdown": {
    "TimeoutSeconds": 30
  },
  "Mcp": {
    "Enabled": true,
    "EndpointPath": "/mcp"
  },
  "Ai": {
    "Enabled": false,
    "Model": "",
    "ApiKey": "",
    "BaseUrl": "",
    "WireFormat": "OpenAiChatCompletions",
    "Relay": "Generic",
    "MaxOutputTokens": 16384,
    "MaxHistoryChars": 400000,
    "MaxOutlineChars": 24000,
    "MaxToolResultChars": 24000,
    "MaxToolIterations": 16,
    "MaxProviderRetries": 5,
    "ProviderRetryBaseDelayMs": 1000
  },
  "Auth": {
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30,
    "Jwt": {
      "Issuer": "codecafe",
      "Audience": "codecafe"
    }
  }
}