<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
  </PropertyGroup>

  <!--
    Composition root plus the three transports (Rest, Mcp, AgUi). Transports hold no business logic:
    each endpoint and each MCP tool authenticates, maps shapes, and calls exactly one Application
    handler.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Hosting" Version="1.9.0-preview.260603.1" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" Version="1.9.0-preview.260603.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeCafe.Application\CodeCafe.Application.csproj" />
    <ProjectReference Include="..\CodeCafe.Domain\CodeCafe.Domain.csproj" />
    <ProjectReference Include="..\CodeCafe.Infrastructure\CodeCafe.Infrastructure.csproj" />
  </ItemGroup>

</Project>
