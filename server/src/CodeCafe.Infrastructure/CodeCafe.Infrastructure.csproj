<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- OpenAI SDK Responses API types are still marked experimental (OPENAI001). -->
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
  </PropertyGroup>

  <!--
    Implementations of the Application ports: EF Core/Postgres, ASP.NET Identity, OpenIddict stores,
    the OpenAI client and Markdig conversion. This is also where the EF migrations live; the
    migrations assembly is pinned to this project's assembly name.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.39.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.9.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="OpenAI" Version="2.11.0" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeCafe.Application\CodeCafe.Application.csproj" />
    <ProjectReference Include="..\CodeCafe.Domain\CodeCafe.Domain.csproj" />
  </ItemGroup>

  <!-- The delegating chat clients and the context-enriching agent stay internal; their tests exercise
       them directly rather than through the whole agent pipeline. -->
  <ItemGroup>
    <InternalsVisibleTo Include="CodeCafe.Server.Tests" />
    <InternalsVisibleTo Include="CodeCafe.Infrastructure.Tests" />
  </ItemGroup>

</Project>
